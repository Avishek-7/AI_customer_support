# Backend environment variables
# Keep JWT/DB values in sync with root .env.example
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database config (choose one canonical style and keep consistent across env files)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ai_customer_support
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Derived Postgres connection string used by backend runtime
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@localhost:5432/ai_customer_support

# AI Engine URL
AI_ENGINE_URL=http://localhost:9000

# Redis URL for rate limiting and cache
REDIS_URL=redis://localhost:6379/0

# When true, auth/login and other rate-limited routes fail closed if Redis is unavailable.
# Set false only for local development fallback.
RATE_LIMIT_FAIL_CLOSED_ON_REDIS_UNAVAILABLE=true

# Frontend base URL for password reset links
FRONTEND_URL=http://localhost:3000

# Internal API key for service-to-service authentication
INTERNAL_API_KEY=your_internal_api_key_change_this_in_production
