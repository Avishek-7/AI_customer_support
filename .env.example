# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ai_customer_support
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT Authentication (keep in sync with backend/.env.example)
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production

# If backend uses single-URL DB config, derive and set:
# DATABASE_URL=postgresql+psycopg2://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:POSTGRES_PORT/POSTGRES_DB

# Internal service authentication (AI engine -> backend callbacks)
INTERNAL_API_KEY=change_this_internal_service_key

# Google AI (Gemini)
GOOGLE_API_KEY=your_google_api_key
